__pycache__/
dist/
build/
target/
.gradle/

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System/Environment files
.DS_Store
Thumbs.db
.env
.env.local
*.env.*

# Logs and coverage
*.log
coverage/
htmlcov/
.coverage

# Cache directories
.mypy_cache/
.pytest_cache/
```