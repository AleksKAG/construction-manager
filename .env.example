DB_PATH=./construction.db
PORT=8080

# Qwen (OpenAI-compatible API) for AI summary endpoint /api/v1/agent/summary
# Leave QWEN_API_KEY empty to use built-in local fallback summary.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional: Yandex AI Studio "AI Manager" via /v1/responses
# To enable set AI_PROVIDER=yandex_manager and fill values below.
AI_PROVIDER=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_PROMPT_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# S3 Configuration (Timeweb)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=your-bucket-id-here
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here
S3_REGION=ru-1
DB_FILE_NAME=construction.db

# Upload interval in seconds (default: 300 = 5 minutes)
UPLOAD_INTERVAL=300
