PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/construction_manager?sslmode=disable
RUN_DB_MIGRATIONS=true
DB_WAIT_MAX_ATTEMPTS=40
DB_WAIT_DELAY_SECONDS=2

# Альтернативно можно не задавать DATABASE_URL и передать компоненты подключения:
# POSTGRESQL_HOST=5.42.122.236
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=gen_user
# POSTGRESQL_PASSWORD=your_password
# POSTGRESQL_DBNAME=default_db
# POSTGRESQL_SSLMODE=require

# Qwen (OpenAI-compatible API) for AI summary endpoint /api/v1/agent/summary
# Leave QWEN_API_KEY empty to use built-in local fallback summary.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# PostgreSQL credentials for docker-compose (optional overrides)
POSTGRES_DB=construction_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
